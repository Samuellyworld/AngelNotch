{
  "manifest_version": 3,
  "name": "AngelNotch Browser Bridge",
  "version": "1.0.0",
  "description": "Shows YouTube playback and Chrome downloads in AngelNotch.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "downloads"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
